algoritmo "ContagemComPara"

var
  contador: inteiro
  limitador: inteiro

inicio
  escreval("Iniciando....")

  limitador <- 3

  para contador de 1 ate limitador faca
    escreval("Repetição: ", contador)
  fimpara

  escreval("Fora do bloco de repetição: ", contador)
  escreval("Fim")

fimalgoritmo